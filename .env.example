# 大量子 配置
# 复制成 .env 后填写。也可以在网页右上角「设置」里填，会自动写回这个文件。

# ============ DeepSeek ============
# 必填。在 https://platform.deepseek.com/api_keys 申请。
DEEPSEEK_API_KEY=

# 可选。默认 https://api.deepseek.com
DEEPSEEK_BASE_URL=

# 可选。deepseek-flash（便宜，推荐）或 deepseek-v4-pro（更强，贵约 4 倍）
DEEPSEEK_MODEL=deepseek-flash

# ============ 分析参数 ============
# 每个请求塞多少条评论。太小则请求多、太大会让模型偷懒漏标签。
LIANGDAZI_BATCH_SIZE=200

# 并发请求数。DeepSeek flash 并发上限 2500，但别开太猛。
# 注意：并发数 ≥ 批次数时，一批都命中不了缓存（缓存要等前序请求落盘）。
LIANGDAZI_CONCURRENCY=8

# 最多分析多少条评论。0 = 全部。
# 评论上万时全量跑又慢又贵，填个上限会做均匀随机抽样，
# 抽样比例会写进报告。也可以在网页上按运行单独设。
LIANGDAZI_SAMPLE_LIMIT=0
