# ============ 密钥与凭据 ============
# 绝对不要提交。网页「设置」里填的 key 会写进这里。
.env
.env.local
.env.*.local
*.pem
*.key

# ============ 运行数据 ============
# 评论原文、各阶段中间产物、生成的报告。
# 含真实网友的用户名和发言，且可能量很大 —— 不进版本库。
data/

# 采集导出与临时工作目录。
# 这些常常直接躺在仓库根目录上（从浏览器/表格工具导出），一不小心就会被
# `git add -A` 一把搂进来。里面是真实网友的发言和用户名，**绝不能推**。
_xls_tmp/
*评论导出*
*评论*.csv
*评论*.xlsx
*评论*.tsv
*comments*.csv

# 通用表格/数据文件（放在根目录的导出产物）
/*.csv
/*.xlsx
/*.xls
/*.tsv
/*.jsonl

# ============ Python ============
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.vendor/
*.egg-info/

# ============ 编辑器 / 系统 ============
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ============ 杂项 ============
*.log
